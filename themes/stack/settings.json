{
  "sections": [
    {
      "title": "侧栏与个人资料",
      "description": "对应 Stack 的 sidebar 配置，未填写的站点资料沿用博客设置。",
      "fields": [
        {
          "key": "sidebar_avatar",
          "label": "头像地址",
          "type": "url",
          "default": "",
          "description": "留空使用博客 Logo。"
        },
        {
          "key": "sidebar_avatar_enabled",
          "label": "显示头像",
          "type": "checkbox",
          "default": "1"
        },
        {
          "key": "sidebar_emoji",
          "label": "头像角标 Emoji",
          "type": "text",
          "default": "🍥",
          "maxlength": 30
        },
        {
          "key": "sidebar_subtitle",
          "label": "侧栏副标题",
          "type": "textarea",
          "default": "",
          "maxlength": 500,
          "description": "留空使用博客副标题或站点描述。"
        },
        {
          "key": "sidebar_compact",
          "label": "紧凑侧栏",
          "type": "checkbox",
          "default": "0"
        },
        {
          "key": "menu_items",
          "label": "自定义导航",
          "type": "textarea",
          "default": "[]",
          "maxlength": 10000,
          "description": "JSON 数组；留空或 [] 使用首页、归档、分类、标签、搜索、友链和独立页面。每项为 {\"name\":\"关于\",\"url\":\"/about\",\"icon\":\"user\",\"new_tab\":false}。图标名使用主题 assets/icons 中的文件名。"
        },
        {
          "key": "social_links",
          "label": "社交链接",
          "type": "textarea",
          "default": "[]",
          "maxlength": 10000,
          "description": "JSON 数组，例如 [{\"name\":\"GitHub\",\"url\":\"https://github.com/jkjoy\",\"icon\":\"brand-github\",\"new_tab\":true}]。"
        }
      ]
    },
    {
      "title": "外观与配色",
      "fields": [
        {
          "key": "color_scheme",
          "label": "默认配色",
          "type": "select",
          "default": "auto",
          "options": {
            "auto": "跟随系统",
            "light": "浅色模式",
            "dark": "深色模式"
          }
        },
        {
          "key": "color_scheme_toggle",
          "label": "显示深浅色切换入口",
          "type": "checkbox",
          "default": "1",
          "description": "访客的选择保存在自己的浏览器中。"
        },
        {
          "key": "category_colors",
          "label": "分类颜色",
          "type": "textarea",
          "default": "{}",
          "maxlength": 10000,
          "description": "以分类 slug 为键的 JSON 对象，例如 {\"life\":{\"background\":\"#9b6142\",\"color\":\"#ffffff\"}}。仅接受十六进制颜色。"
        }
      ]
    },
    {
      "title": "右侧小组件",
      "description": "对应 Stack 的 widgets。使用英文逗号分隔组件名称，可调整顺序；留空隐藏该区域。",
      "fields": [
        {
          "key": "widgets_home",
          "label": "列表页组件",
          "type": "text",
          "default": "search,archives,categories,tag-cloud",
          "description": "支持 search（搜索）、archives（归档）、categories（分类）、tag-cloud（标签云）。"
        },
        {
          "key": "widgets_page",
          "label": "文章页组件",
          "type": "text",
          "default": "toc",
          "description": "支持 toc（目录）及上述列表页组件。目录仅在正文包含标题时出现。"
        },
        {
          "key": "widget_archives_limit",
          "label": "归档显示年份数",
          "type": "select",
          "default": "5",
          "options": {
            "3": "3 年",
            "5": "5 年",
            "10": "10 年",
            "20": "20 年"
          }
        },
        {
          "key": "widget_categories_limit",
          "label": "分类显示数量",
          "type": "select",
          "default": "10",
          "options": {
            "5": "5 项",
            "10": "10 项",
            "20": "20 项",
            "50": "50 项"
          }
        },
        {
          "key": "widget_tags_limit",
          "label": "标签显示数量",
          "type": "select",
          "default": "10",
          "options": {
            "5": "5 项",
            "10": "10 项",
            "20": "20 项",
            "50": "50 项"
          }
        }
      ]
    },
    {
      "title": "文章与阅读",
      "description": "对应 Stack 的 article 配置，正文与隐藏内容权限由 SBlog 处理。",
      "fields": [
        {
          "key": "article_cover_enabled",
          "label": "显示文章封面",
          "type": "checkbox",
          "default": "1",
          "description": "使用单篇配置的封面，或从公开正文中提取首张图片。"
        },
        {
          "key": "article_excerpt_length",
          "label": "自动摘要长度",
          "type": "select",
          "default": "120",
          "options": {
            "0": "不显示",
            "80": "80 字",
            "120": "120 字",
            "180": "180 字",
            "240": "240 字"
          }
        },
        {
          "key": "article_list_tags",
          "label": "列表页显示标签",
          "type": "checkbox",
          "default": "0"
        },
        {
          "key": "article_show_date",
          "label": "显示发布日期",
          "type": "checkbox",
          "default": "1"
        },
        {
          "key": "article_show_updated",
          "label": "显示最后更新日期",
          "type": "checkbox",
          "default": "0"
        },
        {
          "key": "article_reading_time",
          "label": "显示阅读时长",
          "type": "checkbox",
          "default": "1"
        },
        {
          "key": "article_reading_speed",
          "label": "阅读速度",
          "type": "select",
          "default": "250",
          "options": {
            "200": "每分钟 200 字",
            "250": "每分钟 250 字",
            "300": "每分钟 300 字",
            "400": "每分钟 400 字"
          }
        },
        {
          "key": "article_toc",
          "label": "显示文章目录",
          "type": "checkbox",
          "default": "1"
        },
        {
          "key": "article_heading_anchor",
          "label": "显示标题锚点",
          "type": "checkbox",
          "default": "0"
        },
        {
          "key": "article_code_copy",
          "label": "代码块复制按钮",
          "type": "checkbox",
          "default": "1"
        },
        {
          "key": "article_highlight",
          "label": "代码语法高亮",
          "type": "checkbox",
          "default": "1",
          "description": "仅对标明且受支持的代码语言加载本地高亮脚本，颜色沿用 Stack 原版的 Chroma 配色。"
        },
        {
          "key": "article_line_numbers",
          "label": "代码块显示行号",
          "type": "checkbox",
          "default": "1",
          "description": "对应 Stack 示例的 Chroma 行号；单个代码块可用 linenos=false 关闭，用 linenostart 设置起始行号，hl_lines 标记重点行。"
        },
        {
          "key": "article_image_zoom",
          "label": "正文图片灯箱浏览",
          "type": "checkbox",
          "default": "1"
        },
        {
          "key": "image_processing_enabled",
          "label": "本地上传图片响应式处理",
          "type": "checkbox",
          "default": "1",
          "description": "使用服务器 GD 为本地上传图片生成响应式尺寸；未安装 GD 或不支持的图片格式保留原图，不处理外部图片。"
        },
        {
          "key": "image_processing_widths",
          "label": "响应式图片宽度",
          "type": "text",
          "default": "480,800,1024,1600",
          "maxlength": 200,
          "description": "英文逗号分隔的像素宽度，例如 480,800,1024,1600；只缩小图片，不放大原图。"
        },
        {
          "key": "article_related",
          "label": "显示相关文章",
          "type": "checkbox",
          "default": "1"
        },
        {
          "key": "article_related_limit",
          "label": "相关文章数量",
          "type": "select",
          "default": "3",
          "options": {
            "2": "2 篇",
            "3": "3 篇",
            "4": "4 篇",
            "6": "6 篇"
          }
        },
        {
          "key": "article_overrides",
          "label": "单篇文章配置",
          "type": "textarea",
          "default": "{}",
          "maxlength": 20000,
          "description": "JSON 对象，以文章 ID 或 slug 为键。示例：{\"hello\":{\"cover\":\"/uploads/cover.jpg\",\"subtitle\":\"文章副标题\",\"toc\":true,\"reading_time\":true,\"license\":\"CC BY 4.0\",\"license_url\":\"https://creativecommons.org/licenses/by/4.0/\"}}。封面和副标题可用于列表；密码保护与回复隐藏正文不会进入摘要或搜索。 还可用 math、mermaid 布尔值为单篇文章控制公式和图表渲染。"
        }
      ]
    },
    {
      "title": "数学公式与 Mermaid 图表",
      "description": "资源随主题本地提供，仅在对应页面需要时加载。Mermaid 使用严格安全模式，错误内容保留原始代码。",
      "fields": [
        {
          "key": "article_math",
          "label": "渲染数学公式",
          "type": "checkbox",
          "default": "0",
          "description": "使用 KaTeX 渲染 $…$、$$…$$、\\(…\\)、\\[…\\]，不处理代码块内的公式。"
        },
        {
          "key": "article_mermaid",
          "label": "渲染 Mermaid 图表",
          "type": "checkbox",
          "default": "1",
          "description": "仅在文章含 mermaid 代码块时加载本地 Mermaid。"
        },
        {
          "key": "mermaid_look",
          "label": "图表风格",
          "type": "select",
          "default": "classic",
          "options": {
            "classic": "经典",
            "handDrawn": "手绘"
          }
        },
        {
          "key": "mermaid_light_theme",
          "label": "浅色模式图表主题",
          "type": "select",
          "default": "default",
          "options": {
            "default": "默认",
            "neutral": "中性",
            "forest": "森林",
            "base": "基础"
          }
        },
        {
          "key": "mermaid_dark_theme",
          "label": "深色模式图表主题",
          "type": "select",
          "default": "dark",
          "options": {
            "dark": "深色",
            "default": "默认",
            "neutral": "中性",
            "forest": "森林",
            "base": "基础"
          }
        },
        {
          "key": "mermaid_transparent_background",
          "label": "图表使用透明背景",
          "type": "checkbox",
          "default": "0"
        }
      ]
    },
    {
      "title": "提示块图标",
      "description": "正文使用 > [!NOTE] 等提示块标记时显示对应图标。",
      "fields": [
        {
          "key": "article_alert_note",
          "label": "说明（NOTE）",
          "type": "text",
          "default": "📝",
          "maxlength": 30
        },
        {
          "key": "article_alert_tip",
          "label": "提示（TIP）",
          "type": "text",
          "default": "💡",
          "maxlength": 30
        },
        {
          "key": "article_alert_important",
          "label": "重要（IMPORTANT）",
          "type": "text",
          "default": "📌",
          "maxlength": 30
        },
        {
          "key": "article_alert_warning",
          "label": "警告（WARNING）",
          "type": "text",
          "default": "⚠️",
          "maxlength": 30
        },
        {
          "key": "article_alert_caution",
          "label": "注意（CAUTION）",
          "type": "text",
          "default": "🚨",
          "maxlength": 30
        }
      ]
    },
    {
      "title": "分享卡片",
      "description": "对应 Stack 的 opengraph.twitter 配置。",
      "fields": [
        {
          "key": "opengraph_twitter_site",
          "label": "Twitter / X 账号",
          "type": "text",
          "default": "",
          "maxlength": 100,
          "description": "例如 @jkjoy，留空不输出账号。"
        },
        {
          "key": "opengraph_twitter_card",
          "label": "分享卡片样式",
          "type": "select",
          "default": "summary_large_image",
          "options": {
            "summary_large_image": "大图摘要",
            "summary": "摘要"
          }
        }
      ]
    },
    {
      "title": "日期与版权声明",
      "fields": [
        {
          "key": "date_published",
          "label": "发布日期格式",
          "type": "text",
          "default": "Y年m月d日",
          "maxlength": 80,
          "description": "使用 PHP date 格式，例如 Y-m-d 或 M d, Y。"
        },
        {
          "key": "date_updated",
          "label": "更新日期格式",
          "type": "text",
          "default": "Y年m月d日",
          "maxlength": 80
        },
        {
          "key": "article_license_enabled",
          "label": "显示文章许可声明",
          "type": "checkbox",
          "default": "0"
        },
        {
          "key": "article_license_default",
          "label": "默认许可说明",
          "type": "text",
          "default": "Licensed under CC BY-NC-SA 4.0",
          "maxlength": 500
        },
        {
          "key": "article_license_url",
          "label": "许可协议链接",
          "type": "url",
          "default": "https://creativecommons.org/licenses/by-nc-sa/4.0/"
        }
      ]
    },
    {
      "title": "评论与搜索",
      "description": "评论使用 SBlog 原生评论，不加载第三方评论系统；审核、验证码、回复与身份信息沿用博客设置和插件。",
      "fields": [
        {
          "key": "comments_enabled",
          "label": "显示原生评论区",
          "type": "checkbox",
          "default": "1"
        },
        {
          "key": "comments_title",
          "label": "评论区标题",
          "type": "text",
          "default": "评论",
          "maxlength": 80
        },
        {
          "key": "comments_placeholder",
          "label": "评论输入提示",
          "type": "text",
          "default": "欢迎留下你的想法…",
          "maxlength": 200
        },
        {
          "key": "search_enabled",
          "label": "启用站内搜索",
          "type": "checkbox",
          "default": "1"
        },
        {
          "key": "search_placeholder",
          "label": "搜索输入提示",
          "type": "text",
          "default": "输入关键词搜索…",
          "maxlength": 100
        }
      ]
    },
    {
      "title": "页脚",
      "fields": [
        {
          "key": "footer_since",
          "label": "建站年份",
          "type": "text",
          "default": "2026",
          "maxlength": 4,
          "description": "与当前年份组成版权年份区间。"
        },
        {
          "key": "footer_custom_text",
          "label": "页脚附加文字",
          "type": "textarea",
          "default": "",
          "maxlength": 2000,
          "description": "纯文本，可换行。"
        },
        {
          "key": "footer_show_powered",
          "label": "显示 SBlog 程序署名",
          "type": "checkbox",
          "default": "1"
        },
        {
          "key": "footer_show_theme",
          "label": "显示主题及原作者署名",
          "type": "checkbox",
          "default": "1"
        },
        {
          "key": "footer_beian",
          "label": "备案号",
          "type": "text",
          "default": "",
          "maxlength": 150,
          "description": "留空沿用博客备案设置。"
        }
      ]
    },
    {
      "title": "自定义代码",
      "description": "由站点管理员维护，应用于 Stack 主题的公开页面。",
      "fields": [
        {
          "key": "custom_css",
          "label": "自定义 CSS",
          "type": "textarea",
          "default": "",
          "maxlength": 20000,
          "description": "无需 style 标签，建议用 .stack-theme 限制样式范围。"
        },
        {
          "key": "custom_js",
          "label": "自定义 JavaScript",
          "type": "textarea",
          "default": "",
          "maxlength": 20000,
          "description": "无需 script 标签。"
        }
      ]
    }
  ]
}
